<!--
  CLEO-II magnet: materials and vis attributes shared by all magnet fragments. Included (inside <detectors>, before
  the magnet detectors) by compact/magnet/solenoid_*.xml. Do not include it directly in a top-level file.
  Element materials used directly: Iron (G4_Fe 7.874, GEMC parity), Aluminum, Copper.
-->
<lccdd>
  <materials>
    <!-- low-carbon yoke steel (POISSON model "1010 steel at 7.87 g/cm3"; composition of the SREL slabs unknown) -->
    <material name="Magnet_YokeSteel">
      <D type="density" value="7.87" unit="g/cm3"/>
      <fraction n="0.9935" ref="Fe"/>
      <fraction n="0.0045" ref="Mn"/>
      <fraction n="0.0010" ref="C"/>
      <fraction n="0.0010" ref="Si"/>
    </material>
    <!-- cryostat stainless steel (= GEMC SL_StainlessSteel of magnet/solid_solenoid__materials_Original.txt) -->
    <material name="Magnet_StainlessSteel">
      <D type="density" value="8.02" unit="g/cm3"/>
      <fraction n="0.68" ref="Fe"/>
      <fraction n="0.19" ref="Cr"/>
      <fraction n="0.10" ref="Ni"/>
      <fraction n="0.02" ref="Mn"/>
      <fraction n="0.01" ref="Si"/>
    </material>
    <!-- G4_STAINLESS-STEEL (Geant4 NIST: 8.00 g/cm3, Fe:Cr:Ni = 74:18:9 atoms), GEMC-parity cryostat -->
    <material name="Magnet_G4StainlessSteel">
      <D type="density" value="8.00" unit="g/cm3"/>
      <composite n="74" ref="Fe"/>
      <composite n="18" ref="Cr"/>
      <composite n="9"  ref="Ni"/>
    </material>
    <!-- CLEO-II conductor (ESTIMATE, NIM A320 Fig. 4): 16 x 5.1 mm high-purity Al with a ~4.0 x 1.2 mm Cu/NbTi
         insert (Cu:NbTi = 1.3:1 by volume, Nb-47Ti), 0.2 mm insulation (G10) -->
    <material name="Magnet_CLEOCoilConductor">
      <D type="density" value="2.92" unit="g/cm3"/>
      <fraction n="0.816"  ref="Al"/>
      <fraction n="0.096"  ref="Cu"/>
      <fraction n="0.0265" ref="Nb"/>
      <fraction n="0.0235" ref="Ti"/>
      <fraction n="0.038"  ref="G10"/>
    </material>
  </materials>

  <display>
    <vis name="Magnet_YokeVis"        ref="slategray"   alpha="0.5" showDaughters="false" visible="true"/>
    <vis name="Magnet_EndcapVis"      ref="steelblue"   alpha="0.5" showDaughters="false" visible="true"/>
    <vis name="Magnet_CoilVis"        ref="darkorange"  alpha="0.8" showDaughters="false" visible="true"/>
    <vis name="Magnet_ShellVis"       ref="silver"      alpha="0.5" showDaughters="false" visible="true"/>
    <vis name="Magnet_CryostatVis"    ref="lightgray"   alpha="0.4" showDaughters="false" visible="true"/>
    <vis name="Magnet_CorrectorVis"   ref="chocolate"   alpha="0.8" showDaughters="false" visible="true"/>
    <vis name="Magnet_ProvisionalVis" ref="yellowgreen" alpha="0.5" showDaughters="false" visible="true"/>
  </display>
</lccdd>
