<!--
  VALIDATION ONLY: full-SoLID magnet exactly as GEMC builds it = magnet_moved/solid_solenoid__geometry_v4.txt
  (numbers as entered, G4_Fe = Iron, Pgon radii used as apothems -> octagon 8.24 % too large, iron 715.6 t)
  + solid_solenoid_cryo__geometry_Original.txt (cleo_coil_cryostat_gemc.xml). Use instead of solenoid_v4.xml to
  compare with GEMC (extents, masses, material scans). The physics geometry is solenoid_v4.xml ("v4c").
  GEMC "Pgon" with rot "0 0 22.5deg" = Polyhedra phi0 = -22.5 deg (ACTIVE RotationZ(-22.5 deg)).
-->
<lccdd>
  <detectors>
    <include ref="${DETECTOR_PATH}/compact/magnet/magnet_materials.xml"/>
    <include ref="${DETECTOR_PATH}/compact/magnet/cleo_coil_cryostat_gemc.xml"/>
    <detector id="MagnetYoke_ID" name="MagnetYoke" type="SoLID_CLEOMagnet" vis="InvisibleWithDaughters">
      <comment>GEMC parity: magnet_moved v4 (passive)</comment>
      <octagon nsides="8" phi0="-22.5*deg"/>
      <!-- ================= GEMC v4 parity (solid_solenoid__geometry_v4.txt, numbers as entered) ================= -->
      <part name="InnerOctagon_GEMC" inner="oct" outer="oct" material="Iron" vis="Magnet_YokeVis"
           >
        <zplane z="-266.70*cm" rmin="191.075*cm" rmax="230.142*cm"/>
        <zplane z=" 209.23*cm" rmin="191.075*cm" rmax="230.142*cm"/>
        <zplane z=" 224.79*cm" rmin="191.075*cm" rmax="217.692*cm"/>
      </part>
      <part name="OuterOctagon_GEMC" inner="oct" outer="oct" material="Iron" vis="Magnet_YokeVis"
           >
        <zplane z="-266.70*cm" rmin="239.763*cm" rmax="278.832*cm"/>
        <zplane z=" 209.23*cm" rmin="239.763*cm" rmax="278.832*cm"/>
      </part>
      <part name="SpacerBarUpstream_GEMC" inner="oct" outer="oct" material="Iron" vis="Magnet_YokeVis"
           >
        <zplane z="-266.70*cm" rmin="230.142*cm" rmax="239.763*cm"/>
        <zplane z="-241.20*cm" rmin="230.142*cm" rmax="239.763*cm"/>
      </part>
      <part name="SpacerBarDownstream_GEMC" inner="oct" outer="oct" material="Iron" vis="Magnet_YokeVis"
           >
        <zplane z="182.73*cm" rmin="230.142*cm" rmax="239.763*cm"/>
        <zplane z="209.23*cm" rmin="230.142*cm" rmax="239.763*cm"/>
      </part>
      <part name="UpstreamCoilCollar_GEMC" inner="oct" outer="oct" material="Iron" vis="Magnet_YokeVis"
           >
        <zplane z="-266.70*cm" rmin="144.145*cm" rmax="191.075*cm"/>
        <zplane z="-189.23*cm" rmin="144.145*cm" rmax="191.075*cm"/>
      </part>
      <part name="UpstreamPlug_GEMC" inner="oct" outer="oct" material="Iron" vis="Magnet_EndcapVis"
