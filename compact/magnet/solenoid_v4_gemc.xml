        <zplane z="183.83*cm" rmin="278.832*cm" rmax="285.24*cm"/>
        <zplane z="209.23*cm" rmin="278.832*cm" rmax="285.24*cm"/>
      </part>

      <!-- ================= round endcap parts: identical in v4c and GEMC v4 (= CAD v4 within 0.3 cm) ================= -->
      <part name="EndcapCylinder" inner="round" outer="round" material="Iron" vis="Magnet_EndcapVis">
