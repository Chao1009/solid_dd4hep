<!--
  Common visualization attributes. Named colors are in compact/colors.xml (CSS names, use them via ref="...").
  Subsystem-specific vis attributes live in the subsystem fragments and MUST carry the subsystem prefix
  (e.g. LGC_TankVis, FAEC_ModuleVis): DD4hep throws on duplicate vis names.
-->
<display>
  <vis name="InvisibleNoDaughters"   showDaughters="false" visible="false"/>
  <vis name="InvisibleWithDaughters" showDaughters="true"  visible="false"/>

  <!-- generic material-layer looks, usable by any subsystem -->
  <vis name="MatLayerVis_Lead"      ref="darkgray"    alpha="0.6"/>
  <vis name="MatLayerVis_Tungsten"  ref="dimgray"     alpha="0.6"/>
  <vis name="MatLayerVis_Iron"      ref="slategray"   alpha="0.8"/>
  <vis name="MatLayerVis_Aluminum"  ref="lightgray"   alpha="0.6"/>
  <vis name="MatLayerVis_Copper"    ref="chocolate"   alpha="0.8"/>
  <vis name="MatLayerVis_EJ204"     ref="lightyellow" alpha="0.6"/>
  <vis name="MatLayerVis_Scint"     ref="lightyellow" alpha="0.6"/>
  <vis name="MatLayerVis_Kapton"    ref="orange"      alpha="0.6"/>
  <vis name="MatLayerVis_Gas"       ref="InvisibleNoDaughters"/>
  <vis name="MatLayerVis_Air"       ref="InvisibleNoDaughters"/>
</display>
