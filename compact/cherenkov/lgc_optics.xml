  <materials>
    <!-- radiator: CO2 at 20 degC and 1 atm (GEMC SL_LGCCgas_SIDIS = G4_CARBON_DIOXIDE at 1.84212 mg/cm3) -->
    <material name="LGC_CO2" state="gas">
      <D type="density" value="1.84212e-3" unit="g/cm3"/>
      <T type="temperature" value="293.15" unit="kelvin"/>
      <P type="pressure" value="101325." unit="pascal"/>
      <composite n="1" ref="C"/>
      <composite n="2" ref="O"/>
      <property name="RINDEX"    ref="LGC_RINDEX_CO2"/>
      <property name="ABSLENGTH" ref="LGC_ABSLENGTH_CO2"/>
    </material>
    <!-- entrance/exit windows: polyvinyl fluoride (Tedlar) C2H3F, 1.45 g/cm3 (preCDR p96) -->
    <material name="LGC_PVF">
      <D type="density" value="1.45" unit="g/cm3"/>
      <composite n="2" ref="C"/>
      <composite n="3" ref="H"/>
      <composite n="1" ref="F"/>
    </material>
    <!-- mirror blank: carbon-fiber reinforced polymer at the GEMC SL_RCFP density (0.54 g/cm2 for 3 mm) -->
    <material name="LGC_CFRP">
      <D type="density" value="1.8" unit="g/cm3"/>
      <fraction n="0.65" ref="C"/>
      <fraction n="0.35" ref="Epoxy"/>
    </material>
    <!-- Winston cone body: SiO2 glass at 2.203 g/cm3 (GEMC SL_LGC_WinstonCone); reflection by the skin surface -->
    <material name="LGC_ConeGlass">
      <D type="density" value="2.203" unit="g/cm3"/>
      <fraction n="1.0" ref="SiliconDioxide"/>
    </material>
    <!-- magnetic shield: mu-metal (GEMC SL_MuMetal, mass fractions) -->
    <material name="LGC_MuMetal">
      <D type="density" value="8.7" unit="g/cm3"/>
      <fraction n="0.77" ref="Ni"/>
      <fraction n="0.16" ref="Fe"/>
      <fraction n="0.05" ref="Cu"/>
      <fraction n="0.02" ref="Cr"/>
    </material>
    <!-- H12700-03 UV-glass window (borosilicate composition; RINDEX from GEMC SL_H12700UVwin, no absorption) -->
    <material name="LGC_UVGlass">
      <D type="density" value="2.23" unit="g/cm3"/>
      <fraction n="0.807" ref="SiliconOxide"/>
      <fraction n="0.130" ref="BoronOxide"/>
      <fraction n="0.040" ref="SodiumOxide"/>
      <fraction n="0.023" ref="AluminumOxide"/>
      <property name="RINDEX" ref="LGC_RINDEX_UVGlass"/>
    </material>
    <!-- photocathode pixel (0.2 um): bialkali, CO2 index as in GEMC; EFFICIENCY = QE table for digitization -->
    <material name="LGC_Photocathode">
      <D type="density" value="3.4" unit="g/cm3"/>
      <composite n="2" ref="K"/>
      <composite n="1" ref="Cs"/>
      <composite n="1" ref="Sb"/>
      <property name="RINDEX"     ref="LGC_RINDEX_CO2"/>
      <property name="EFFICIENCY" ref="LGC_QE_H12700"/>
    </material>
  </materials>

  <surfaces>
    <!-- GEMC lg_cherenkov__mirrors_*.txt: dielectric_metal / polished / unified, skin surfaces -->
    <opticalsurface name="LGC_MirrorSurface" type="dielectric_metal" finish="polished" model="unified" value="0">
      <property name="REFLECTIVITY" ref="LGC_REFLECTIVITY_Mirror"/>
      <property name="EFFICIENCY"   ref="LGC_ZERO"/>
    </opticalsurface>
    <opticalsurface name="LGC_ConeSurface" type="dielectric_metal" finish="polished" model="unified" value="0">
      <property name="REFLECTIVITY" ref="LGC_REFLECTIVITY_Mirror"/>
      <property name="EFFICIENCY"   ref="LGC_ZERO"/>
    </opticalsurface>
    <opticalsurface name="LGC_LightStopSurface" type="dielectric_metal" finish="polished" model="unified" value="0">
      <property name="REFLECTIVITY" ref="LGC_ZERO"/>
      <property name="EFFICIENCY"   ref="LGC_ZERO"/>
    </opticalsurface>
  </surfaces>
</lccdd>
