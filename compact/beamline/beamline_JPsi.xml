<!--
  J/psi, DDVCS and SoLID-lite beamline (GEMC geometry/beamline_moved/solid_JPsi_beamline, exit pipe extended to
  802.5 cm in 2025-04, kill disk 2026-10-25). Requires from the top level: TargetCenter_z (-315 cm).
  * entrance pipe: Al r_out 1.25 cm / vacuum 1.22 cm, z -627.5..-327.5 cm, Be window 0.25 mm at its end
    (5 cm of air before the 15 cm LH2 cell). The GEMC vacuum "dead absorber" disk BMD1 (z -627.5..-627.3,
    G4_Galactic inside G4_Galactic) has no physical effect and is not built.
  * exit pipe: Al cone r_out 1.8 -> 29 cm, wall 1 mm, z -302.5..802.5 cm; Be window 0.25 mm at z = -302.5 cm;
    kill disk z 802.3..802.5 cm (2 mm, GEMC Kryptonite B3DM; the readme prose says 1 mm, the txt has 2 mm).
    The exit cone (half angle 1.41 deg) clears the v4 nose cone and the SoLID-lite "nomod" iron.
-->
<lccdd>
  <define>
    <constant name="Beamline_EntrancePipe_zmin"  value="TargetCenter_z - 312.5*cm"/> <!-- -627.5 cm -->
    <constant name="Beamline_EntrancePipe_zmax"  value="TargetCenter_z - 12.5*cm"/>  <!-- -327.5 cm -->
    <constant name="Beamline_EntrancePipe_rout"  value="1.25*cm"/>
    <constant name="Beamline_EntrancePipe_rvac"  value="1.22*cm"/>
    <constant name="Beamline_EntranceWindow_t"   value="0.025*cm"/>
    <constant name="Beamline_ExitPipe_z0"        value="TargetCenter_z + 12.5*cm"/>  <!-- -302.5 cm -->
    <constant name="Beamline_ExitPipe_z1"        value="802.5*cm"/>
    <constant name="Beamline_ExitPipe_rout0"     value="1.8*cm"/>
    <constant name="Beamline_ExitPipe_rout1"     value="29*cm"/>
    <constant name="Beamline_ExitPipe_wall"      value="0.1*cm"/>
    <constant name="Beamline_ExitWindow_t"       value="0.025*cm"/>
    <constant name="Beamline_Kill_t"             value="0.2*cm"/>
  </define>

  <display>
    <vis name="Beamline_PipeVis"   ref="silver"     alpha="0.5" showDaughters="true" visible="true"/>
    <vis name="Beamline_WindowVis" ref="lightcoral" alpha="0.8" visible="true"/>
    <vis name="Beamline_KillVis"   ref="black"      alpha="0.5" visible="true"/>
  </display>

  <!-- Kill disk = replacement of the GEMC "Kryptonite" disk (gemc 2.9 MSteppingAction kills every track whose
       material is Kryptonite). A zero maximum track length makes G4UserSpecialCuts (registered for all particles
       by G4StepLimiterPhysics, which ddsim always adds) stop every track that takes a step in the disk.
       Its remaining kinetic energy is deposited locally (G4UserSpecialCuts uses fStopButAlive, so a stopped e+
       may still annihilate at rest; GEMC uses fStopAndKill). -->
  <limits>
    <limitset name="Beamline_KillLimits">
      <limit name="track_length_max" particles="*" value="0.0" unit="mm"/>
    </limitset>
  </limits>

  <detectors>
    <detector id="Beamline_ID" name="Beamline" type="SoLID_Beamline">
      <pipe name="EntrancePipe" material="Aluminum" fill="Vacuum">
        <zplane z="Beamline_EntrancePipe_zmin" rout="Beamline_EntrancePipe_rout" rvac="Beamline_EntrancePipe_rvac"/>
        <zplane z="Beamline_EntrancePipe_zmax" rout="Beamline_EntrancePipe_rout" rvac="Beamline_EntrancePipe_rvac"/>
        <window name="EntranceWindow" material="Beryllium"
                zmin="Beamline_EntrancePipe_zmax - Beamline_EntranceWindow_t" zmax="Beamline_EntrancePipe_zmax"/>
      </pipe>
      <pipe name="ExitPipe" material="Aluminum" fill="Vacuum">
        <zplane z="Beamline_ExitPipe_z0" rout="Beamline_ExitPipe_rout0" rvac="Beamline_ExitPipe_rout0 - Beamline_ExitPipe_wall"/>
        <zplane z="Beamline_ExitPipe_z1" rout="Beamline_ExitPipe_rout1" rvac="Beamline_ExitPipe_rout1 - Beamline_ExitPipe_wall"/>
        <window name="ExitWindow" material="Beryllium"
                zmin="Beamline_ExitPipe_z0" zmax="Beamline_ExitPipe_z0 + Beamline_ExitWindow_t"/>
        <kill name="KillDisk" zmin="Beamline_ExitPipe_z1 - Beamline_Kill_t" zmax="Beamline_ExitPipe_z1"
              limits="Beamline_KillLimits"/>
      </pipe>
    </detector>
  </detectors>
</lccdd>
