<!--
  SoLID large-angle EM calorimeter (LAEC), full SoLID SIDIS/J/psi/DDVCS and SoLID-Lite (identical in GEMC
  ec_segmented_moved and ec_segmented_separated).
  GEMC reference: solid_gemc/geometry/ec_segmented_moved/solid_SIDIS_ec_largeangle__{parameters,geometry}_Original.txt
  Module stack, materials and lattice identical to compact/ecal/ec_SIDIS_FA.xml (see there):
    preshower = 1.12 cm Pb sheet + 2 cm polystyrene tile (sensitive) + 2 cm Al support tile per module;
    shower    = 194 x (paint 0.05, Pb 0.5, paint 0.05, Mylar 0.12, polystyrene 1.5, Mylar 0.12 mm) = 45.396 cm.
  module id = ANL id (1..1748, stable across configurations), sector = floor(phi/12 deg) + 1.

  Hall-frame z (cm): Pb -62.818..-61.698, PS scint -61.698..-59.698, Al -59.698..-57.698, shower -57.698..-12.302.
  Counts: 307 modules (centre R 87.24-136.39 cm; hexagon edges 81.19-142.39 cm, i.e. 1.6 cm inside the
  cryostat inner wall at r = 144 cm). The inner edge is set by the ANL lattice hole, not by Rmin = 83 cm.

  Overridable constants (define them BEFORE including this file; DD4hep keeps the first definition):
    LAEC_z_shower, LAEC_rsel_min, LAEC_rsel_max, LAEC_paint_thick (0 = preCDR/short-endcap 0.224 cm layer),
    LAEC_rods_enable, LAEC_PhiMask_* (azimuthal segments, default off = GEMC parity).
  Requires from the top level: nothing (system ids from compact/definitions.xml).
-->
<lccdd>
  <define>
    <include ref="${DETECTOR_PATH}/compact/ecal/anl_lattice.xml"/>  <!-- EC_ANL_* lattice constants -->

    <!-- ===== position / selection (GEMC ec_segmented_moved SIDIS LA) ===== -->
    <constant name="LAEC_z_shower"        value="-35*cm"/>    <!-- centre of the 194-layer shower stack -->
    <constant name="LAEC_rsel_min"        value="83*cm"/>     <!-- module-centre selection window -->
    <constant name="LAEC_rsel_max"        value="137*cm"/>

    <!-- ===== optional azimuthal mask (e.g. SIDIS-lite S2 LA segments); 0 = full ring = GEMC parity ===== -->
    <constant name="LAEC_PhiMask_enable"  value="0"/>
    <constant name="LAEC_PhiMask_overlap" value="0"/>         <!-- 0: module centre inside a window; 1: any overlap -->
    <constant name="LAEC_PhiMask_nseg"    value="4"/>
    <constant name="LAEC_PhiMask_dphi"    value="24*deg"/>
    <constant name="LAEC_PhiMask_phi0"    value="0*deg"/>     <!-- used only if fewer centres than nseg are given -->
    <!-- placeholder centres (LA segmentation not defined yet) -->
    <constant name="LAEC_PhiMask_centers" type="string" value="42*deg,138*deg,222*deg,318*deg"/>

    <!-- ===== shashlik module (ANL drawing 200318; GEMC moved) ===== -->
    <constant name="LAEC_module_apothem"  value="5.413*cm"/>  <!-- side 6.25 cm -->
    <constant name="LAEC_module_phi0"     value="30*deg"/>    <!-- vertices at 30+60k deg: two sides parallel to y -->
    <constant name="LAEC_nlayers"         value="194"/>
    <constant name="LAEC_paint_thick"     value="0.005*cm"/>  <!-- per side (GEMC Thickness_paint 0.01 total) -->
    <constant name="LAEC_Pb_thick"        value="0.05*cm"/>
    <constant name="LAEC_gap_thick"       value="0.012*cm"/>  <!-- per side (GEMC Thickness_gap 0.024 total) -->
    <constant name="LAEC_scint_thick"     value="0.15*cm"/>
    <constant name="LAEC_layer_thick"     value="2*LAEC_paint_thick+LAEC_Pb_thick+2*LAEC_gap_thick+LAEC_scint_thick"/>
    <constant name="LAEC_shower_length"   value="LAEC_nlayers*LAEC_layer_thick"/>          <!-- 45.396 cm -->
    <constant name="LAEC_shower_zfront"   value="LAEC_z_shower-LAEC_shower_length/2"/>    <!-- -57.698 cm -->
    <constant name="LAEC_rods_enable"     value="1"/>
    <constant name="LAEC_rod_radius"      value="0.3*cm"/>
    <constant name="LAEC_rod_r"           value="5.6255*cm"/> <!-- rod axis distance from module axis (towards corners) -->

    <!-- ===== preshower + support ===== -->
    <constant name="LAEC_ps_Pb_thick"     value="1.12*cm"/>   <!-- 2 X0 -->
    <constant name="LAEC_ps_scint_thick"  value="2.0*cm"/>
    <constant name="LAEC_support_thick"   value="2.0*cm"/>
    <constant name="LAEC_ps_zfront"       value="LAEC_shower_zfront-LAEC_support_thick-LAEC_ps_scint_thick"/>  <!-- -61.698 -->
    <constant name="LAEC_ps_Pb_zfront"    value="LAEC_ps_zfront-LAEC_ps_Pb_thick"/>                             <!-- -62.818 -->
  </define>

  <!-- EC materials (identical in every compact/ecal fragment; GEMC/Geant4 NIST values) -->
  <materials>
    <material name="EC_Polystyrene">   <!-- G4_POLYSTYRENE -->
      <D type="density" value="1.06" unit="g/cm3"/>
      <composite n="8" ref="C"/>
      <composite n="8" ref="H"/>
      <constant name="BirksConstant" value="0.126*mm/MeV"/>
    </material>
    <material name="EC_Paint_TiO2">
      <D type="density" value="4.26" unit="g/cm3"/>
      <composite n="1" ref="Ti"/>
      <composite n="2" ref="O"/>
    </material>
    <material name="EC_Paint_BaSO4">
      <D type="density" value="4.5" unit="g/cm3"/>
      <composite n="1" ref="Ba"/>
      <composite n="1" ref="S"/>
      <composite n="4" ref="O"/>
    </material>
    <material name="EC_Paint">         <!-- GEMC SL_EC_paint (TiO2 powder paint, SDU4 module) -->
      <D type="density" value="1.5" unit="g/cm3"/>
      <fraction n="0.45" ref="EC_Polystyrene"/>
      <fraction n="0.35" ref="EC_Paint_TiO2"/>
      <fraction n="0.20" ref="EC_Paint_BaSO4"/>
    </material>
    <material name="EC_StainlessSteel"> <!-- G4_STAINLESS-STEEL -->
      <D type="density" value="8.0" unit="g/cm3"/>
      <fraction n="0.7462" ref="Fe"/>
      <fraction n="0.1690" ref="Cr"/>
      <fraction n="0.0848" ref="Ni"/>
    </material>
  </materials>

  <display>
    <vis name="LAEC_EnvelopeVis"          ref="InvisibleWithDaughters"/>
    <vis name="LAEC_ShowerModuleVis"      ref="steelblue" alpha="0.5" showDaughters="false" visible="true"/>
    <vis name="LAEC_PreShowerModuleVis"   ref="gold"      alpha="0.5" showDaughters="false" visible="true"/>
    <vis name="LAEC_RadiatorVis"          ref="dimgray"   alpha="0.4" visible="true"/>
  </display>

  <detectors>
    <detector id="LAECPreShower_ID" name="LAECPreShower" type="SoLID_HexShashlykEMCal"
              readout="LAECPreShowerHits" vis="LAEC_EnvelopeVis">
      <comment>LAEC preshower: Pb radiator sheet + 2 cm scintillator tile (sensitive) + 2 cm Al support tile per module</comment>
      <lattice type="anl_hex_rows" rows="EC_ANL_rows" pitch="EC_ANL_pitch" row_pitch="EC_ANL_row_pitch"
               row_center="EC_ANL_row_center" sector_dphi="EC_ANL_sector_dphi"/>
      <selection rmin="LAEC_rsel_min" rmax="LAEC_rsel_max"/>
      <phi_mask enable="LAEC_PhiMask_enable" overlap="LAEC_PhiMask_overlap" nseg="LAEC_PhiMask_nseg"
                dphi="LAEC_PhiMask_dphi" phi0="LAEC_PhiMask_phi0" centers="LAEC_PhiMask_centers"/>
      <envelope type="tube" margin="0.1*mm" material="Air"/>
      <module type="hex_stack" nsides="6" apothem="LAEC_module_apothem" phi0="LAEC_module_phi0"
              z_front="LAEC_ps_zfront" material="Air" vis="LAEC_PreShowerModuleVis">
        <layer repeat="1">
          <slice name="PSScint"  material="EC_Polystyrene" thickness="LAEC_ps_scint_thick" sensitive="true"/>
          <slice name="Support"  material="Aluminum"       thickness="LAEC_support_thick"/>
        </layer>
      </module>
      <sheet name="Radiator" material="Lead" rmin="LAEC_rsel_min" rmax="LAEC_rsel_max"
             z_front="LAEC_ps_Pb_zfront" thickness="LAEC_ps_Pb_thick" vis="LAEC_RadiatorVis"/>
    </detector>

    <detector id="LAECShower_ID" name="LAECShower" type="SoLID_HexShashlykEMCal"
              readout="LAECShowerHits" vis="LAEC_EnvelopeVis">
      <comment>LAEC shower: 194-layer shashlik modules, scintillator slices sensitive (layer 1..194, slice 5)</comment>
      <lattice type="anl_hex_rows" rows="EC_ANL_rows" pitch="EC_ANL_pitch" row_pitch="EC_ANL_row_pitch"
               row_center="EC_ANL_row_center" sector_dphi="EC_ANL_sector_dphi"/>
      <selection rmin="LAEC_rsel_min" rmax="LAEC_rsel_max"/>
      <phi_mask enable="LAEC_PhiMask_enable" overlap="LAEC_PhiMask_overlap" nseg="LAEC_PhiMask_nseg"
                dphi="LAEC_PhiMask_dphi" phi0="LAEC_PhiMask_phi0" centers="LAEC_PhiMask_centers"/>
      <envelope type="tube" margin="0.1*mm" material="Air"/>
      <module type="hex_stack" nsides="6" apothem="LAEC_module_apothem" phi0="LAEC_module_phi0"
              z_front="LAEC_shower_zfront" material="Air" vis="LAEC_ShowerModuleVis">
        <layer repeat="LAEC_nlayers">
          <slice name="PaintF"   material="EC_Paint"       thickness="LAEC_paint_thick"/>
          <slice name="Absorber" material="Lead"           thickness="LAEC_Pb_thick">
            <rods enable="LAEC_rods_enable" n="6" radius="LAEC_rod_radius" r="LAEC_rod_r" phi0="LAEC_module_phi0"
                  material="EC_StainlessSteel"/>
          </slice>
          <slice name="PaintB"   material="EC_Paint"       thickness="LAEC_paint_thick"/>
          <slice name="GapF"     material="Mylar"          thickness="LAEC_gap_thick"/>
          <slice name="Scint"    material="EC_Polystyrene" thickness="LAEC_scint_thick" sensitive="true">
            <rods enable="LAEC_rods_enable" n="6" radius="LAEC_rod_radius" r="LAEC_rod_r" phi0="LAEC_module_phi0"
                  material="EC_StainlessSteel"/>
          </slice>
          <slice name="GapB"     material="Mylar"          thickness="LAEC_gap_thick"/>
        </layer>
      </module>
    </detector>
  </detectors>

  <readouts>
    <readout name="LAECPreShowerHits">
      <segmentation type="NoSegmentation"/>
      <id>system:8,sector:5,module:11,layer:8,slice:4</id>
    </readout>
    <readout name="LAECShowerHits">
      <segmentation type="NoSegmentation"/>
      <id>system:8,sector:5,module:11,layer:8,slice:4</id>
    </readout>
  </readouts>
</lccdd>
