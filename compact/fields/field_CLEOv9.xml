<!--
  Full-SoLID solenoid field: 2D POISSON map solenoid_CLEOv9 (CLEOv9.am = CLEOv8 with the endcap moved +45 cm,
  "longer endcap"; 1282 turns x 3266 A), the map used by all GEMC *_moved_full gcards (FIELD solenoid_CLEOv9).
  Caveat: the 3D yoke is v4, but its TOSCA map solenoid_v4.dat is not public (404);
  CLEOv9 is used until it is recovered. Reference values (map): Bz(0,0) = 13775 G, Bz(0,-315 cm) = 81.6 G,
  Bz(0,-350 cm) = 27.3 G, integral Bz dz on axis 5.220 T m.
  File: GEMC ASCII map with <mfield> header (R 0..500 cm x Z -600..600 cm, 1 cm, gauss, cylindrical-z); grid and
  unit are read from the header and cross-checked against <dimensions>. scale is dimensionless (e.g. -1 to flip
  the polarity, 3300/3266 = 1.0104 for the NIM current, ignoring saturation).
  The map is looked up in ./fieldmaps, then in ${DETECTOR_PATH}/fieldmaps, else downloaded there once from the
  solid_gemc repository (pinned commit 6826f84, 26 295 531 bytes). Offline: copy solenoid_CLEOv9.dat into
  ${DETECTOR_PATH}/fieldmaps/ (e.g. from a solid_gemc checkout: field/solenoid_CLEOv9.dat).
-->
<lccdd>
  <fields>
    <field type="SoLID_FieldMapB" name="SolenoidField" field_type="magnetic" coord_type="BrBz"
           field_map="fieldmaps/solenoid_CLEOv9.dat"
           cache="${DETECTOR_PATH}/fieldmaps"
           url="https://raw.githubusercontent.com/JeffersonLab/solid_gemc/6826f84fc9a9d561c82c655d970fe00e584399dd/field/solenoid_CLEOv9.dat"
           scale="1.0">
      <dimensions>
        <R step="1.0*cm" min="0*cm"    max="500*cm"/>
        <Z step="1.0*cm" min="-600*cm" max="600*cm"/>
        <translationCoord x="0*cm" y="0*cm" z="0*cm"/>
      </dimensions>
    </field>
  </fields>
</lccdd>
