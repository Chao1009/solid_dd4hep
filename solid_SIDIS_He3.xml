<lccdd>
  <info name="solid_SIDIS_He3" title="SoLID SIDIS, polarized 3He target (default configuration)"
        author="SoLID collaboration"
        url="https://github.com/JeffersonLab/solid_dd4hep"
        status="development"
        version="v0.3 2026-11">
    <comment>Full SoLID, longer-endcap magnet (GEMC *_moved), gcard reference: solid_gemc/script/solid_SIDIS_He3_moved_full.gcard</comment>
  </info>

  <!-- Standard environmental conditions: 20 degC, 1 atm -->
  <std_conditions type="NTP"/>

  <define>
    <include ref="${DD4hepINSTALL}/DDDetectors/compact/detector_types.xml"/>
    <include ref="${DETECTOR_PATH}/compact/definitions.xml"/>
    <!-- ======================= configuration constants ======================= -->
    <constant name="SoLID_Config" value="1"/>  <!-- 1 SIDIS-He3, 2 SIDIS-NH3, 3 PVDIS, 4 J/psi, 5 DDVCS, 11 J/psi-lite, 12 DDVCS-lite, 13 SIDIS-He3-lite -->
    <constant name="TargetCenter_z" value="-350*cm"/>  <!-- center of the 40 cm 3He cell -->
  </define>

  <includes>
    <gdmlFile ref="${DD4hepINSTALL}/DDDetectors/compact/elements.xml"/>
    <file ref="${DETECTOR_PATH}/compact/materials.xml"/>
    <file ref="${DETECTOR_PATH}/compact/optics.xml"/>
  </includes>

  <limits>
    <limitset name="world_limits"/>
    <limitset name="beamline_limits">
      <limit name="step_length_max" particles="*" value="1.0" unit="mm"/>
      <limit name="track_length_max" particles="*" value="1.0" unit="mm"/>
      <limit name="time_max" particles="*" value="0.1" unit="ns"/>
      <limit name="ekin_min" particles="*" value="0.001" unit="MeV"/>
      <limit name="range_min" particles="*" value="0.1" unit="mm"/>
    </limitset>
    <limitset name="cal_limits">
      <limit name="step_length_max" particles="*" value="5.0" unit="mm"/>
    </limitset>
  </limits>

  <regions>
    <region name="world_region" eunit="MeV" lunit="mm" cut="0.001" threshold="0.001">
      <limitsetref name="world_limits"/>
    </region>
  </regions>

  <display>
    <include ref="${DETECTOR_PATH}/compact/colors.xml"/>
    <include ref="${DETECTOR_PATH}/compact/display.xml"/>
  </display>

  <!-- ======================= magnetic field ======================= -->
  <include ref="${DETECTOR_PATH}/compact/fields/field_CLEOv9.xml"/>

  <!-- ======================= detectors ======================= -->
  <include ref="${DETECTOR_PATH}/compact/configs/full_common.xml"/>
  <include ref="${DETECTOR_PATH}/compact/target/target_He3.xml"/>
  <include ref="${DETECTOR_PATH}/compact/beamline/beamline_SIDIS_He3.xml"/>
</lccdd>
