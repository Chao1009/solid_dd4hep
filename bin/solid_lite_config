#!/usr/bin/env python3
# SPDX-License-Identifier: LGPL-3.0-or-later
"""Write the top-level compact file of a SoLID-Lite option.

SoLID-Lite is not one design: the iron, the azimuthal coverage of the forward and large-angle detectors and the
detector types are open choices (docs/lite_options.md). This tool writes the top-level file for one set of
choices from the fragments in compact/, so that an option is one command and not a hand-edited copy.

  solid_lite_config --experiment SIDIS_He3                       # = solid_SIDIS_He3_lite.xml (the committed file)
  solid_lite_config --experiment SIDIS_He3 --fa full -o he3_fullFA.xml
  solid_lite_config --experiment SIDIS_He3 --iron stage1 -o he3_stage1.xml
  solid_lite_config --experiment JPsi --fa 4seg24 --mrpc off -o jpsi_4fa.xml
  ddsim --compactFile he3_fullFA.xml ...                          # with DETECTOR_PATH set (thissolid.sh)

  --experiment   SIDIS_He3 (40 cm polarized 3He cell at z = -350 cm), JPsi (15 cm LH2 at -315 cm), DDVCS (JPsi with
                 the forward muon detector)
  --iron         stage1 = CLEO-II iron as built; stage2 = with front piece and endcap (provisional).
                 Default: stage2 for SIDIS_He3, stage1 otherwise. The field map follows the iron.
  --fa           forward-angle detectors: 4seg24 (four segments of 24 deg), full (all azimuth), none
  --la           large-angle detectors: full, none
  --mrpc         on / off: forward MRPC (off: time of flight from the scintillator pads only)
  --name         name in <info> (default: from the output file name, else solid_<experiment>_lite)
  -o FILE        output (default: standard output)

With the defaults of an experiment the output is the committed solid_<experiment>_lite.xml only for SIDIS_He3; the
committed J/psi and DDVCS files follow the GEMC set-ups instead (full forward azimuth, MRPC, POISSON map CLEOv10).
"""
import argparse
import os
import sys

EXPERIMENTS = {
    # config number, target z, target fragment, beamline fragment, extra fragments, title
    "SIDIS_He3": (13, "-350*cm", "center of the 40 cm 3He cell", "target/target_He3.xml", "beamline/beamline_SIDIS_He3.xml", [],
                  "SoLID-Lite SIDIS, polarized 3He target"),
    "JPsi": (11, "-315*cm", "center of the 15 cm LH2 cell", "target/target_LH2_15cm.xml", "beamline/beamline_JPsi.xml", [],
             "SoLID-Lite J/psi, 15 cm LH2 target"),
    "DDVCS": (12, "-315*cm", "center of the 15 cm LH2 cell", "target/target_LH2_15cm.xml", "beamline/beamline_JPsi.xml",
              ["muon/muon_DDVCS.xml"], "SoLID-Lite DDVCS: J/psi-lite + forward muon detector, 15 cm LH2 target"),
}
IRON = {
    "stage1": ("magnet/solenoid_nomod.xml", "fields/field_SoLIDlite_stage1_2D.xml", "stage 1: unmodified CLEO-II iron"),
    "stage2": ("magnet/solenoid_lite_sidis.xml", "fields/field_SoLIDlite_stage2_2D.xml",
               "stage 2: CLEO-II iron with front piece and endcap; PROVISIONAL"),
}
FA_TEXT = {"4seg24": "forward angle in 4 segments of 24 deg", "full": "forward angle full", "none": "no forward-angle detectors"}

HEAD = """<!-- SPDX-License-Identifier: LGPL-3.0-or-later -->
<lccdd>
  <info name="{name}" title="{title} ({iron_text})"
        author="SoLID collaboration"
        url="https://github.com/JeffersonLab/solid_dd4hep"
        status="development"
        version="v0.3 2026-11">
    <comment>{comment}</comment>
  </info>

  <!-- Standard environmental conditions: 20 degC, 1 atm -->
  <std_conditions type="NTP"/>

  <define>
    <include ref="${{DD4hepINSTALL}}/DDDetectors/compact/detector_types.xml"/>
    <include ref="${{DETECTOR_PATH}}/compact/definitions.xml"/>
    <!-- ======================= configuration constants ======================= -->
    <constant name="SoLID_Config" value="{config}"/>
    <constant name="TargetCenter_z" value="{target_z}"/>  <!-- {target_text} -->
{coverage}  </define>

  <includes>
    <gdmlFile ref="${{DD4hepINSTALL}}/DDDetectors/compact/elements.xml"/>
    <file ref="${{DETECTOR_PATH}}/compact/materials.xml"/>
    <file ref="${{DETECTOR_PATH}}/compact/optics.xml"/>
  </includes>

  <limits>
    <limitset name="world_limits"/>
    <limitset name="beamline_limits">
      <limit name="step_length_max" particles="*" value="1.0" unit="mm"/>
      <limit name="track_length_max" particles="*" value="1.0" unit="mm"/>
      <limit name="time_max" particles="*" value="0.1" unit="ns"/>
      <limit name="ekin_min" particles="*" value="0.001" unit="MeV"/>
      <limit name="range_min" particles="*" value="0.1" unit="mm"/>
    </limitset>
    <limitset name="cal_limits">
      <limit name="step_length_max" particles="*" value="5.0" unit="mm"/>
    </limitset>
  </limits>

  <regions>
    <region name="world_region" eunit="MeV" lunit="mm" cut="0.001" threshold="0.001">
      <limitsetref name="world_limits"/>
    </region>
  </regions>

  <display>
    <include ref="${{DETECTOR_PATH}}/compact/colors.xml"/>
    <include ref="${{DETECTOR_PATH}}/compact/display.xml"/>
  </display>

  <!-- ======================= magnetic field ======================= -->
  <include ref="${{DETECTOR_PATH}}/compact/{field}"/>

  <!-- ======================= detectors ======================= -->
  <!-- written by bin/solid_lite_config: {options_text} -->
{detectors}</lccdd>
"""


def coverage_block(fa):
    if fa == "4seg24":
        return ("    <!-- ======================= forward-angle coverage ======================= -->\n"
                "    <!-- 4 segments of 24 deg. For full azimuth (segments applied in the analysis): solid_lite_config, fa = full -->\n"
                "    <include ref=\"${DETECTOR_PATH}/compact/configs/lite_FA_4seg24.xml\"/>\n")
    if fa == "full":
        return ("    <!-- ======================= forward-angle coverage ======================= -->\n"
                "    <!-- full azimuth with the SoLID-Lite detector types: segments are applied in the analysis -->\n"
                "    <include ref=\"${DETECTOR_PATH}/compact/configs/lite_FA_full.xml\"/>\n")
    return ""


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--experiment", required=True, choices=sorted(EXPERIMENTS))
    ap.add_argument("--iron", choices=sorted(IRON))
    ap.add_argument("--fa", default="4seg24", choices=sorted(FA_TEXT))
    ap.add_argument("--la", default="full", choices=("full", "none"))
    ap.add_argument("--mrpc", default="off", choices=("on", "off"))
    ap.add_argument("--name")
    ap.add_argument("-o", "--output")
    a = ap.parse_args(argv)

    config, target_z, target_text, target, beamline, extra, title = EXPERIMENTS[a.experiment]
    iron = a.iron or ("stage2" if a.experiment == "SIDIS_He3" else "stage1")
    magnet, field, iron_text = IRON[iron]
    if a.fa == "none" and a.la == "none":
        ap.error("--fa none --la none leaves no detector")
    default_name = "solid_%s_lite" % a.experiment
    name = a.name or (os.path.splitext(os.path.basename(a.output))[0] if a.output else default_name)

    frags = [magnet]
    if a.la == "full":
        frags.append("tracking/gem_LA_lite.xml")
    if a.fa != "none":
        frags += ["tracking/gem_FA_lite.xml", "cherenkov/cherenkov_lite.xml"]
    if a.la == "full":
        frags.append("ecal/ec_SIDIS_LA.xml")
    if a.fa != "none":
        frags.append("ecal/ec_lite_FA.xml")
    if a.la == "full":
        frags.append("timing/spd_LA.xml")
    if a.fa != "none":
        frags.append("timing/spd_FA.xml")
        if a.mrpc == "on":
            frags.append("timing/mrpc_FA.xml")
    frags += extra + [target, beamline]

    parts = ["large angle full" if a.la == "full" else "no large-angle detectors", FA_TEXT[a.fa]]
    if a.fa != "none":
        parts.append("one CO2 Cherenkov")
        parts.append("forward MRPC" if a.mrpc == "on" else "scintillator pads instead of the MRPC")
    comment = ("SoLID-Lite option after the High-Lumi workshop of October 2026: %s. Written by bin/solid_lite_config; "
               "options and what is provisional: docs/lite_options.md" % ", ".join(parts))
    options = "--experiment %s --iron %s --fa %s --la %s --mrpc %s" % (a.experiment, iron, a.fa, a.la, a.mrpc)
    # an XML comment must not contain two hyphens in a row
    options_text = "experiment = %s, iron = %s, fa = %s, la = %s, mrpc = %s" % (a.experiment, iron, a.fa, a.la, a.mrpc)
    text = HEAD.format(name=name, title=title, iron_text=iron_text, comment=comment, config=config, target_z=target_z,
                       target_text=target_text, coverage=coverage_block(a.fa), field=field,
                       options_text=options_text,
                       detectors="".join('  <include ref="${DETECTOR_PATH}/compact/%s"/>\n' % f for f in frags))
    if a.output:
        with open(a.output, "w") as f:
            f.write(text)
        print("wrote %s (%s): %s" % (a.output, name, options), file=sys.stderr)
    else:
        sys.stdout.write(text)
    return 0


if __name__ == "__main__":
    sys.exit(main())
