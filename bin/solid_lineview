#!/usr/bin/env python3
# SPDX-License-Identifier: LGPL-3.0-or-later
"""solid_lineview command: vector line drawings of Geant4 geometry scenes.

The renderer is the Python package ``solid_lineview`` (python/solid_lineview in the source tree,
<prefix>/python/solid_lineview when installed; thissolid.sh puts the latter on PYTHONPATH).  This
script only finds the package and calls its main(); run it with --help for the options.
"""
import os
import sys


def _import_main():
    # the copy that belongs to this script comes first, so a source checkout and an install never mix
    here = os.path.dirname(os.path.realpath(__file__))
    pkg_dir = os.path.join(os.path.dirname(here), 'python')
    if os.path.isfile(os.path.join(pkg_dir, 'solid_lineview', '__init__.py')):
        sys.path.insert(0, pkg_dir)
    try:
        from solid_lineview.core import main
    except ImportError as exc:
        sys.exit('solid_lineview: cannot import the solid_lineview package (%s); looked in %s and on '
                 'PYTHONPATH (source <prefix>/bin/thissolid.sh)' % (exc, pkg_dir))
    return main


if __name__ == '__main__':
    sys.exit(_import_main()())
