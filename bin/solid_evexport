#!/usr/bin/env python3
# SPDX-License-Identifier: LGPL-3.0-or-later
"""solid_evexport command: EDM4hep output + trajectory file + geometry scene -> event.npz files.

The code is the Python package ``solid_evdisplay`` (python/solid_evdisplay in the source tree,
<prefix>/python/solid_evdisplay when installed; thissolid.sh puts the latter on PYTHONPATH).  This script
only finds the package and calls solid_evdisplay.export.main(); run it with --help for the options.
"""
import os
import sys


def _import_main():
    # the copy that belongs to this script comes first, so a source checkout and an install never mix
    here = os.path.dirname(os.path.realpath(__file__))
    pkg_dir = os.path.join(os.path.dirname(here), 'python')
    if os.path.isfile(os.path.join(pkg_dir, 'solid_evdisplay', '__init__.py')):
        sys.path.insert(0, pkg_dir)
    try:
        from solid_evdisplay.export import main
    except ImportError as exc:
        sys.exit('solid_evexport: cannot import the solid_evdisplay package (%s); looked in %s and on '
                 'PYTHONPATH (source <prefix>/bin/thissolid.sh)' % (exc, pkg_dir))
    return main


if __name__ == '__main__':
    sys.exit(_import_main()())
