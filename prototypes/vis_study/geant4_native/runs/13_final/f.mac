/control/verbose 2
/vis/verbose warnings
/vis/open TSG_OFFSCREEN 1600x1000-0+0
/vis/tsg/offscreen/set/size 3200 2000
/vis/viewer/set/autoRefresh false
/vis/tsg/offscreen/set/format zb_png
/vis/viewer/set/lineSegmentsPerCircle 72
/vis/drawVolume
/vis/viewer/set/background white
/vis/viewer/set/viewpointVector -0.75 0.48 -0.45
/vis/viewer/set/upVector 0 1 0
/vis/viewer/set/targetPoint 0 0 0.6 m
/vis/viewer/set/projection p 25.7 deg
/vis/viewer/zoomTo 1.75
/vis/viewer/addCutawayPlane 0 0 0 m 1 0 0
/vis/viewer/set/style surface
/vis/viewer/set/hiddenEdge true
/vis/viewer/set/edge true
/control/shell date +T0=%s.%N
/vis/tsg/offscreen/set/file p1_persp_surface_edges.png
/vis/viewer/rebuild
/control/shell date +T1=%s.%N
/control/echo "=== P3 clay: all light grey opaque, surface+edges"
/vis/geometry/set/colour all -1 0.93 0.93 0.93 1
/vis/geometry/set/forceSolid all -1 false
/vis/tsg/offscreen/set/file p3_persp_clay.png
/vis/viewer/rebuild
/control/shell date +T2=%s.%N
/vis/viewer/set/lightsVector -0.75 0.48 -0.45
/vis/tsg/offscreen/set/file p4_persp_clay_headlight.png
/vis/viewer/rebuild
/control/shell date +T3=%s.%N
/control/echo "=== P2 black wireframe perspective"
/vis/geometry/set/colour all -1 0 0 0 1
/vis/viewer/set/style wireframe
/vis/viewer/set/hiddenEdge false
/vis/tsg/offscreen/set/file p2_persp_wire.png
/vis/viewer/rebuild
/control/shell date +T4=%s.%N
/control/echo "=== P5 clay as gl2ps pdf (BSP)"
/vis/geometry/set/colour all -1 0.93 0.93 0.93 1
/vis/viewer/set/style surface
/vis/viewer/set/hiddenEdge true
/vis/tsg/offscreen/set/size 1600 1000
/vis/tsg/offscreen/set/format gl2ps_pdf
/vis/tsg/offscreen/set/file p5_persp_clay.pdf
/vis/viewer/rebuild
/control/shell date +T5=%s.%N
