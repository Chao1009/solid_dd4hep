/control/verbose 2
/vis/verbose warnings
/vis/open RayTracer
/vis/drawVolume
/vis/viewer/set/background white
/vis/viewer/set/viewpointVector -0.75 0.48 -0.45
/vis/viewer/set/upVector 0 1 0
/vis/viewer/set/targetPoint 0 0 0.6 m
/vis/viewer/zoomTo 1.9
/vis/rayTracer/column 400
/vis/rayTracer/row 250
/control/shell date +T0=%s.%N
/vis/rayTracer/trace rt_iso_400.jpeg
/control/shell date +T1=%s.%N
/vis/viewer/addCutawayPlane 0 0 0 m 1 0 0
/vis/rayTracer/trace rt_iso_cut_400.jpeg
/control/shell date +T2=%s.%N
/vis/viewer/clearCutawayPlanes
/vis/viewer/set/sectionPlane on 0 0 0 m -1 0 0
/vis/rayTracer/trace rt_section_400.jpeg
/control/shell date +T3=%s.%N
