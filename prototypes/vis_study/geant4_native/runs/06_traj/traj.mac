/control/verbose 2
/vis/verbose warnings
/vis/open TSG_OFFSCREEN 1600x1000-0+0
/vis/tsg/offscreen/set/size 3200 2000
/vis/viewer/set/autoRefresh false
/vis/tsg/offscreen/set/format zb_png
/vis/tsg/offscreen/set/file auto ev_
/vis/viewer/set/lineSegmentsPerCircle 72
/vis/drawVolume
/vis/viewer/set/background white
/vis/viewer/set/viewpointVector -0.75 0.48 -0.45
/vis/viewer/set/upVector 0 1 0
/vis/viewer/set/targetPoint 0 0 0.6 m
/vis/viewer/zoomTo 1.9
/vis/viewer/addCutawayPlane 0 0 0 m 1 0 0
/vis/viewer/set/style surface
/vis/viewer/set/hiddenEdge true
/vis/viewer/set/edge true
/vis/viewer/set/globalLineWidthScale 1.5
/vis/scene/add/trajectories rich
/vis/modeling/trajectories/create/drawByCharge
/vis/modeling/trajectories/drawByCharge-0/default/setDrawStepPts false
/vis/modeling/trajectories/drawByCharge-0/default/setLineWidth 2
/vis/filtering/trajectories/create/attributeFilter
/vis/filtering/trajectories/attributeFilter-0/setAttribute IMag
/vis/filtering/trajectories/attributeFilter-0/addInterval 20 MeV 1000 GeV
/vis/scene/add/hits
/vis/scene/endOfEventAction accumulate 10
/control/echo "=== beamOn 3"
/run/beamOn 3
/control/echo "=== after run: list files"
/vis/tsg/offscreen/set/file t1_cutaway_tracks.png
/vis/viewer/rebuild
/control/echo "=== side section with tracks"
/vis/viewer/clearCutawayPlanes
/vis/viewer/set/sectionPlane on 0 0 0 m -1 0 0
/vis/viewer/set/upVector 0 1 0
/vis/viewer/set/targetPoint 0 0 0 m
/vis/viewer/zoomTo 1.75
/vis/tsg/offscreen/set/file t2_section_tracks.png
/vis/viewer/rebuild
/control/echo "=== same as pdf"
/vis/tsg/offscreen/set/size 1600 1000
/vis/tsg/offscreen/set/format gl2ps_pdf
/vis/tsg/offscreen/set/file t3_section_tracks.pdf
/vis/viewer/rebuild
/control/echo "=== done"
