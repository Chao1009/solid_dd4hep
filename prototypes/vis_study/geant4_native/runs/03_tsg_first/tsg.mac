/control/verbose 2
/vis/verbose warnings
/vis/open TSG_OFFSCREEN 1600x1000-0+0
/vis/tsg/offscreen/set/size 1600 1000
/vis/viewer/set/autoRefresh false
/vis/tsg/offscreen/set/format zb_png
/vis/tsg/offscreen/set/file auto f_
/vis/viewer/set/lineSegmentsPerCircle 72
/vis/drawVolume
/vis/viewer/set/background white
/vis/viewer/set/style surface
/vis/viewer/set/viewpointVector -1 0 0
/vis/viewer/set/upVector 0 1 0
/control/echo "=== T1 side surface default zoom"
/vis/viewer/rebuild
/control/echo "=== T2 side surface zoom 3"
/vis/viewer/zoomTo 3
/vis/viewer/set/targetPoint 0 0 0 m
/vis/viewer/rebuild
/control/echo "=== T3 iso surface cutaway x>0"
/vis/viewer/set/viewpointVector -0.75 0.48 -0.45
/vis/viewer/set/projection p 9 deg
/vis/viewer/addCutawayPlane 0 0 0 m 1 0 0
/vis/viewer/rebuild
/control/echo "=== T4 iso wireframe hiddenEdge cutaway"
/vis/viewer/set/style wireframe
/vis/viewer/set/hiddenEdge true
/vis/viewer/rebuild
/control/echo "=== T5 same as gl2ps_svg"
/vis/tsg/offscreen/set/format gl2ps_svg
/vis/viewer/rebuild
/control/echo "=== done"
