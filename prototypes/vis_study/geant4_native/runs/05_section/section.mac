/control/verbose 2
/vis/verbose warnings
/vis/open TSG_OFFSCREEN 1600x700-0+0
/vis/tsg/offscreen/set/size 3200 1400
/vis/viewer/set/autoRefresh false
/vis/tsg/offscreen/set/format zb_png
/vis/viewer/set/lineSegmentsPerCircle 72
/vis/drawVolume
/vis/viewer/set/background white
/vis/viewer/set/viewpointVector -1 0 0
/vis/viewer/set/upVector 0 1 0
/vis/viewer/set/targetPoint 0 0 0 m
/vis/viewer/zoomTo 1.75
/vis/viewer/set/style surface
/control/echo "=== S1 section x=0 (DCUT), surface"
/vis/viewer/set/sectionPlane on 0 0 0 m 1 0 0
/vis/tsg/offscreen/set/file s1_section_x0.png
/vis/viewer/rebuild
/control/echo "=== S2 section x=0, opaque (transparency off)"
/vis/tsg/offscreen/set/transparency false
/vis/tsg/offscreen/set/file s2_section_x0_notransp.png
/vis/viewer/rebuild
/vis/tsg/offscreen/set/transparency true
/control/echo "=== S3 section x=0, gl2ps pdf"
/vis/tsg/offscreen/set/size 1600 700
/vis/tsg/offscreen/set/format gl2ps_pdf
/vis/tsg/offscreen/set/file s3_section_x0.pdf
/vis/viewer/rebuild
/control/echo "=== S4 slab -5cm<x<5cm via 2 cutaway planes (intersection), surface"
/vis/tsg/offscreen/set/size 3200 1400
/vis/tsg/offscreen/set/format zb_png
/vis/viewer/set/sectionPlane off
/vis/viewer/set/cutawayMode intersection
/vis/viewer/addCutawayPlane -5 0 0 cm 1 0 0
/vis/viewer/addCutawayPlane 5 0 0 cm -1 0 0
/vis/tsg/offscreen/set/file s4_slab.png
/vis/viewer/rebuild
/control/echo "=== S5 beam-eye section z=440 cm"
/vis/viewer/clearCutawayPlanes
/vis/viewer/set/cutawayMode union
/vis/viewer/set/viewpointVector 0 0 1
/vis/viewer/set/targetPoint 0 0 4.4 m
/vis/viewer/zoomTo 3.5
/vis/tsg/offscreen/set/size 2000 2000
/vis/viewer/set/sectionPlane on 0 0 440 cm 0 0 1
/vis/tsg/offscreen/set/file s5_section_z440.png
/vis/viewer/rebuild
/control/echo "=== done"
