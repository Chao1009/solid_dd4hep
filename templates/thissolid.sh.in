#!/bin/sh
# SPDX-License-Identifier: LGPL-3.0-or-later
# Environment for the SoLID DD4hep geometry (generated by CMake).
#
# usage:  source <prefix>/bin/thissolid.sh [configuration]
#   configuration = solid (default, SIDIS 3He) | solid_SIDIS_He3 | solid_SIDIS_NH3 | solid_PVDIS
#                 | solid_JPsi | solid_DDVCS | solid_JPsi_lite | solid_DDVCS_lite | solid_SIDIS_He3_lite
#
# Afterwards:  ddsim --compactFile ${DETECTOR_PATH}/${DETECTOR_CONFIG}.xml ...
#              (or simply $DETECTOR_PATH/$DETECTOR_CONFIG.xml in any DD4hep tool)

export DETECTOR=solid
export DETECTOR_VERSION=@PROJECT_VERSION@
export DETECTOR_PATH=@CMAKE_INSTALL_PREFIX@/@CMAKE_INSTALL_DATADIR@/solid
export DETECTOR_CONFIG=${1:-solid}
export SOLID_DD4HEP_PREFIX=@CMAKE_INSTALL_PREFIX@

if [ ! -f "${DETECTOR_PATH}/${DETECTOR_CONFIG}.xml" ]; then
  echo "thissolid.sh: WARNING: ${DETECTOR_PATH}/${DETECTOR_CONFIG}.xml does not exist" >&2
fi

## the plugin library must be on LD_LIBRARY_PATH for the DD4hep plugin manager
_solid_libdir=@CMAKE_INSTALL_PREFIX@/@CMAKE_INSTALL_LIBDIR@
case ":${LD_LIBRARY_PATH}:" in
  *":${_solid_libdir}:"*) ;;
  *) export LD_LIBRARY_PATH=${_solid_libdir}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}} ;;
esac
_solid_bindir=@CMAKE_INSTALL_PREFIX@/@CMAKE_INSTALL_BINDIR@
case ":${PATH}:" in
  *":${_solid_bindir}:"*) ;;
  *) export PATH=${_solid_bindir}:${PATH} ;;
esac
unset _solid_libdir _solid_bindir
