<!-- partial full configuration (integration test, no magnet/GEM/target) -->
<lccdd>
  <info name="test_gem_partial_full" title="SoLID LGC test (SIDIS)" author="SoLID collaboration" url="https://github.com/JeffersonLab/solid_dd4hep" status="development" version="v0.3 2026-11">
    <comment>full_common without the magnet + GEM: integration overlap / ACTS test</comment>
  </info>
  <std_conditions type="NTP"/>
  <define>
    <include ref="${DD4hepINSTALL}/DDDetectors/compact/detector_types.xml"/>
    <include ref="${DETECTOR_PATH}/compact/definitions.xml"/>
    <constant name="SoLID_Config" value="1"/>
    <constant name="TargetCenter_z" value="-350*cm"/>
  </define>
  <includes>
    <gdmlFile ref="${DD4hepINSTALL}/DDDetectors/compact/elements.xml"/>
    <file ref="${DETECTOR_PATH}/compact/materials.xml"/>
    <file ref="${DETECTOR_PATH}/compact/optics.xml"/>
  </includes>
  <limits>
    <limitset name="world_limits"/>
  </limits>
  <regions>
    <region name="world_region" eunit="MeV" lunit="mm" cut="0.001" threshold="0.001">
      <limitsetref name="world_limits"/>
    </region>
  </regions>
  <display>
    <include ref="${DETECTOR_PATH}/compact/colors.xml"/>
    <include ref="${DETECTOR_PATH}/compact/display.xml"/>
  </display>
  <include ref="${DETECTOR_PATH}/compact/tracking/gem_SIDIS.xml"/>
  <include ref="${DETECTOR_PATH}/compact/cherenkov/lgc_SIDIS.xml"/>
  <include ref="${DETECTOR_PATH}/compact/cherenkov/hgc_SIDIS.xml"/>
  <include ref="${DETECTOR_PATH}/compact/ecal/ec_SIDIS_LA.xml"/>
  <include ref="${DETECTOR_PATH}/compact/ecal/ec_SIDIS_FA.xml"/>
  <include ref="${DETECTOR_PATH}/compact/timing/spd_LA.xml"/>
  <include ref="${DETECTOR_PATH}/compact/timing/spd_FA.xml"/>
  <include ref="${DETECTOR_PATH}/compact/timing/mrpc_FA.xml"/>
</lccdd>
