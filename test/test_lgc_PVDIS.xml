<!-- LGC-only test configuration (PVDIS), no magnetic field -->
<lccdd>
  <info name="test_lgc_PVDIS" title="SoLID LGC test (PVDIS)" author="SoLID collaboration" url="https://github.com/JeffersonLab/solid_dd4hep" status="development" version="v0.3 2026-11">
    <comment>LGC only, for overlap checks and optical-photon tests</comment>
  </info>
  <std_conditions type="NTP"/>
  <define>
    <include ref="${DD4hepINSTALL}/DDDetectors/compact/detector_types.xml"/>
    <include ref="${DETECTOR_PATH}/compact/definitions.xml"/>
    <constant name="SoLID_Config" value="3"/>
    <constant name="TargetCenter_z" value="10*cm"/>
  </define>
  <includes>
    <gdmlFile ref="${DD4hepINSTALL}/DDDetectors/compact/elements.xml"/>
    <file ref="${DETECTOR_PATH}/compact/materials.xml"/>
    <file ref="${DETECTOR_PATH}/compact/optics.xml"/>
  </includes>
  <limits>
    <limitset name="world_limits"/>
  </limits>
  <regions>
    <region name="world_region" eunit="MeV" lunit="mm" cut="0.001" threshold="0.001">
      <limitsetref name="world_limits"/>
    </region>
  </regions>
  <display>
    <include ref="${DETECTOR_PATH}/compact/colors.xml"/>
    <include ref="${DETECTOR_PATH}/compact/display.xml"/>
  </display>
  <include ref="${DETECTOR_PATH}/compact/cherenkov/lgc_PVDIS.xml"/>
</lccdd>
