<!-- test configuration (mask): SPD FA/LA + MRPC FA + DDVCS muon system only -->
<lccdd>
  <info name="test_timing_muon_mask" title="timing + muon test (mask)" author="SoLID" url="" status="test" version="0"/>
  <std_conditions type="NTP"/>
  <define>
    <include ref="${DD4hepINSTALL}/DDDetectors/compact/detector_types.xml"/>
    <include ref="${DETECTOR_PATH}/compact/definitions.xml"/>
    <constant name="SoLID_Config" value="99"/>
    <constant name="TargetCenter_z" value="-315*cm"/>
    <!-- SoLID-Lite FA mask (4 x 24 deg at 42/138/222/318) on SPD FA, MRPC FA; LA mask on too -->
    <constant name="FASPD_UsePhiMask" value="1"/>
    <constant name="FAMRPC_UsePhiMask" value="1"/>
    <constant name="LASPD_UsePhiMask" value="1"/>
  </define>
  <includes>
    <gdmlFile ref="${DD4hepINSTALL}/DDDetectors/compact/elements.xml"/>
    <file ref="${DETECTOR_PATH}/compact/materials.xml"/>
  </includes>
  <display>
    <include ref="${DETECTOR_PATH}/compact/colors.xml"/>
    <include ref="${DETECTOR_PATH}/compact/display.xml"/>
  </display>
  <include ref="${DETECTOR_PATH}/compact/timing/spd_LA.xml"/>
  <include ref="${DETECTOR_PATH}/compact/timing/spd_FA.xml"/>
  <include ref="${DETECTOR_PATH}/compact/timing/mrpc_FA.xml"/>
  <include ref="${DETECTOR_PATH}/compact/muon/muon_DDVCS.xml"/>
</lccdd>
